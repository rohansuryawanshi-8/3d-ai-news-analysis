{
  "explorer.compactFolders": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "frontend/package.json": "frontend/package-lock.json, frontend/pnpm-workspace.yaml, frontend/postcss.config.mjs",
    "frontend/vite.config.ts": "frontend/index.html, frontend/default_shadcn_theme.css",
    "README.md": "docs/ATTRIBUTIONS.md, docs/DEVELOPMENT_NOTES.md"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.pytest_cache": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "frontend/dist": true,
    "frontend/node_modules": true,
    "backend/.venv": true,
    "backend/data": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/.pytest_cache": true,
    "**/__pycache__": true,
    "frontend/dist": true,
    "frontend/node_modules": true,
    "backend/.venv": true,
    "backend/data": true
  }
}
